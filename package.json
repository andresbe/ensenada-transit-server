{
  "name": "ensenada-transit-server",
  "version": "1.0.0",
  "description": "Full backend for Ensenada Transit – auth, routes, tracking, and more.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node scripts/run-migrations.js",
    "create:user": "node scripts/create-user.js",
    "create:admin": "USER_ROLE=admin node scripts/create-user.js",
    "create:driver": "USER_ROLE=driver node scripts/create-user.js",
    "lint": "eslint 'src/**/*.ts'",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ensenada",
    "transit",
    "location",
    "polling"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^13.0.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.11.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
