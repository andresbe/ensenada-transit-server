# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ── PostgreSQL ────────────────────────────────────────────────
# Full connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/ensenada_transit

# ── Redis ─────────────────────────────────────────────────────
# Full connection string (Railway provides this automatically)
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Location tracking ─────────────────────────────────────────
# How long (in seconds) a bus location is considered fresh
LOCATION_TTL_SECONDS=240
# optional keeps old driver APKs working; required enforces JWT on /locations/update
LOCATION_UPDATE_AUTH_MODE=optional
# Optional JSONL file for structured location diagnostics
LOCATION_LOG_FILE=
# Optional token for GET /locations/debug/recent via x-debug-token
LOCATION_DEBUG_TOKEN=
# Temporary public map testing: exact comma-separated Teltonika test tracking IDs.
# Empty/unset keeps every test vehicle private. API service only, not the receiver.
PUBLIC_TEST_VEHICLE_IDS=

# Teltonika receiver (teltonika-ingestion, same private PostgreSQL and Redis).
# Set PORT=8080 on that service only; raw TCP uses TELTONIKA_TCP_PORT.
# ensenada-transit-server owns migrations through 031; receiver never runs migrate.
TELTONIKA_TCP_PORT=5027
TELTONIKA_MAX_FRAME_BYTES=65536
TELTONIKA_MAX_CONNECTIONS=600
TELTONIKA_MAX_IN_FLIGHT=16
TELTONIKA_FRAMES_PER_MINUTE=120
TELTONIKA_IDLE_TIMEOUT_SECONDS=180
TELTONIKA_FRAME_TIMEOUT_SECONDS=30
TELTONIKA_MAX_LIVE_AGE_SECONDS=240
TELTONIKA_OUTBOX_POLL_MS=1000
# Optional direct TCP peer allowlist, NOT an assumed original client IP behind Railway proxy.
TELTONIKA_ALLOWED_PEERS=
# Optional bearer secret for receiver /metrics. Empty disables access.
TELTONIKA_METRICS_TOKEN=

# ── Social auth (optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Email / SMTP ───────────────────────────────────────────────
# Used to send welcome emails after registration.
# For development, use Ethereal Email (https://ethereal.email) — free disposable
# SMTP sandbox. Create a free account and paste the credentials below.
# For production, use any SMTP provider (Gmail, SendGrid, Mailgun, etc.).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# SMTP username (your email address or SMTP account user)
SMTP_USER=
# SMTP password (app password or SMTP account password)
SMTP_PASSWORD=
# The "From" address that appears in outgoing emails
SMTP_FROM_EMAIL=noreply@ensenadatransit.com
# The display name shown alongside the From address
SMTP_FROM_NAME=Ensenada Transit

# Verified ingress proxy IPs/CIDRs, comma-separated. Empty distrusts forwarded IPs.
# Never set true, a hop count, or a catch-all network.
TRUSTED_PROXY_CIDRS=
