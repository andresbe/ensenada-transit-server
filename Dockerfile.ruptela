FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080 RUPTELA_TCP_PORT=5028
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/src/data ./src/data
COPY --from=build --chown=node:node /app/scripts/database-options.js ./scripts/database-options.js
USER node
EXPOSE 5028 8080
CMD ["node", "dist/ruptela/server.js"]
