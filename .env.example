# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ── PostgreSQL ────────────────────────────────────────────────
# Full connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/ensenada_transit

# ── Redis ─────────────────────────────────────────────────────
# Full connection string (Railway provides this automatically)
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────
# Use a long, random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Location tracking ─────────────────────────────────────────
# How long (in seconds) a bus location is considered fresh
LOCATION_TTL_SECONDS=240
# optional keeps old driver APKs working; required enforces JWT on /locations/update
LOCATION_UPDATE_AUTH_MODE=optional
# Optional JSONL file for structured location diagnostics
LOCATION_LOG_FILE=
# Optional token for GET /locations/debug/recent via x-debug-token
LOCATION_DEBUG_TOKEN=

# ── Social auth (optional) ────────────────────────────────────
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Email / SMTP ───────────────────────────────────────────────
# Used to send welcome emails after registration.
# For development, use Ethereal Email (https://ethereal.email) — free disposable
# SMTP sandbox. Create a free account and paste the credentials below.
# For production, use any SMTP provider (Gmail, SendGrid, Mailgun, etc.).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# SMTP username (your email address or SMTP account user)
SMTP_USER=
# SMTP password (app password or SMTP account password)
SMTP_PASSWORD=
# The "From" address that appears in outgoing emails
SMTP_FROM_EMAIL=noreply@ensenadatransit.com
# The display name shown alongside the From address
SMTP_FROM_NAME=Ensenada Transit
