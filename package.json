{
  "name": "ensenada-transit-server",
  "version": "1.0.0",
  "description": "Full backend for Ensenada Transit – auth, routes, tracking, and more.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node scripts/run-migrations.js",
    "preupdates:publish": "npm run build",
    "updates:publish": "node scripts/publish-app-update.js",
    "test:updates": "npm run build && node --test tests/app-updates.test.js",
    "create:user": "node scripts/create-user.js",
    "create:admin": "node scripts/create-admin.js",
    "test:admin": "npm run build && node --test tests/admin-auth.test.js",
    "test:routes": "npm run build && node --test tests/route-import.test.js tests/route-crud.test.js",
    "create:driver": "USER_ROLE=driver node scripts/create-user.js",
    "lint": "eslint 'src/**/*.ts'",
    "type-check": "tsc --noEmit",
    "test:security": "npm run build && node --test tests/database-security.test.js",
    "test:passengers": "npm run build && node --test tests/passengers.test.js tests/passenger-database.test.js",
    "notifications:deliver": "node scripts/deliver-notifications.js",
    "notifications:local": "npm run build && node scripts/notifications-local.js",
    "dev:local": "node scripts/dev-local.js",
    "local:check": "node scripts/dev-local.js --check",
    "local:stop": "node scripts/dev-local.js --stop",
    "test:local": "node --test tests/dev-local.test.js",
    "test:fleet": "npm run build && node --test tests/fleet.test.js",
    "test:tenancy": "npm run build && node --test tests/line-tenancy.test.js",
    "simulate:local": "node scripts/simulate-buses.js",
    "test:simulation": "npm run build && node --test tests/local-simulation.test.js"
  },
  "keywords": [
    "ensenada",
    "transit",
    "location",
    "polling"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^13.0.0",
    "nodemailer": "^6.9.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.11.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
